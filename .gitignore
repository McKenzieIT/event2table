# ==================== 临时文件管理 ====================
# 测试截图（根目录）
*.png
*.jpg
*.jpeg
*.gif
*.svg

# 但保留output/screenshots/目录
!output/screenshots/**/*.png
!output/screenshots/**/*.jpg
!output/screenshots/**/*.jpeg

# 临时报告（根目录）
REPORT.md
*REPORT.md
*IMPLEMENTATION-REPORT.md
*PROGRESS*.md
*SUMMARY.md
*_TEST-*.md
*TEST-*.md

# 但保留output/reports/目录
!output/reports/**/*.md

# ==================== 测试输出（全部排除）====================
frontend/test-results/
output/screenshots/
output/test-results/
test-output/
test-reports/
test-results/
playwright-tests/

# 但保留总结性Markdown报告
!output/reports/*.md
!docs/testing/reports/*.md

# ==================== Claude Skills输出 ====================
# event2table-universal-test：保留配置，忽略输出
.claude/skills/event2table-universal-test/output/
.claude/skills/event2table-universal-test/config/test_configs/

# performance-audit：全部忽略（本地开发工具）
.claude/skills/performance-audit/

# update-docs：忽略输出
.claude/skills/update-docs/output/

# ==================== Scripts临时文件 ====================
scripts/temp/
scripts/temp/*.py
scripts/temp/*.txt

# 日志文件
::log_file
*.log
logs/*.log

# 临时文件
*.tmp
*.temp
*.cache
.DS_Store
Thumbs.db

# ==================== 数据库文件 ====================
# SQLite WAL和SHM文件
*.db-wal
*.db-shm

# 但保留data/目录的结构文件
!data/.gitkeep

