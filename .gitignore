# ==================== 临时文件管理 ====================
# 测试截图（根目录）
*.png
*.jpg
*.jpeg
*.gif
*.svg

# 但保留output/screenshots/目录
!output/screenshots/**/*.png
!output/screenshots/**/*.jpg
!output/screenshots/**/*.jpeg

# 临时报告（根目录）
REPORT.md
*REPORT.md
*IMPLEMENTATION-REPORT.md
*PROGRESS*.md
*_SUMMARY.md

# 但保留output/reports/目录
!output/reports/**/*.md

# 测试输出（全部排除）
output/test-results/
output/screenshots/
playwright-tests/test-results/
playwright-tests/screenshots/
frontend/test-results/
test-results/
test-reports/
test-output/

# 测试日志
*.log
console-error-*.log
playwright-*.log
test-*.log
test-results.txt
webkit-*.txt

# 但保留关键报告
!output/PLAYWRIGHT-IMPLEMENTATION-FINAL-SUMMARY.md
!output/COMPREHENSIVE-TEST-ANALYSIS-2026-03-20.md
!output/SUPPLEMENTARY-TEST-PLAN.md
!output/WEBKIT-COMPATIBILITY-ANALYSIS.md

# 日志文件
::log_file
*.log
logs/*.log

# 临时文件
*.tmp
*.temp
*.cache
.DS_Store
Thumbs.db

# ==================== 数据库文件 ====================
# SQLite WAL和SHM文件
*.db-wal
*.db-shm

# 但保留data/目录的结构文件
!data/.gitkeep

# ==================== Python ====================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ==================== Node.js ====================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

