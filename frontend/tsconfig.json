{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* 渐进式迁移配置 - Progressive Migration */
    "allowJs": true,  // 允许导入JS文件
    "checkJs": false,  // 不检查JS文件语法（仅使用JSDoc）
    "incremental": true,  // 增量编译，加速构建

    /* Linting - Strict Mode Enabled */
    "strict": true,  // ✅ 启用完整严格模式
    "noUnusedLocals": false,  // 保持禁用以避免过度严格
    "noUnusedParameters": false,  // 保持禁用以避免过度严格
    "noFallthroughCasesInSwitch": true,  // 保持启用
    "noImplicitAny": true,  // 已包含在strict中
    "strictNullChecks": true,  // 已包含在strict中
    "strictFunctionTypes": true,  // 已包含在strict中
    "strictBindCallApply": true,  // 已包含在strict中
    "strictPropertyInitialization": true,  // 已包含在strict中
    "noImplicitThis": true,  // 已包含在strict中
    "alwaysStrict": true,  // 已包含在strict中

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@canvas-react/*": ["../canvas-react/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@features/*": ["./src/features/*"],
      "@canvas/*": ["./src/canvas/*"],
      "@event-builder/*": ["./src/event-builder/*"],
      "@analytics/*": ["./src/analytics/*"],
      "@types": ["./src/types"],
      "@ui/*": ["./src/shared/ui/*"],
      "@ui-components/*": ["./src/shared/ui/components/*"],
      "@ui-hooks/*": ["./src/shared/ui/hooks/*"],
      "@ui-utils/*": ["./src/shared/ui/utils/*"],
      "@ui-types": ["./src/shared/ui/types"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",  // 包含JS文件以支持JSDoc检查
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/migration"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}