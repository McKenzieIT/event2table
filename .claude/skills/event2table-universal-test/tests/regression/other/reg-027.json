{
  "id": "REG-027",
  "name": "Categories List",
  "type": "regression",
  "priority": "medium",
  "engine": "agent-browser",
  "url": "http://localhost:5173/categories",
  "timeout": 10000,
  "module": "other",
  "steps": [
    {
      "action": "open",
      "url": "http://localhost:5173/categories"
    },
    {
      "action": "wait",
      "condition": {
        "load": "networkidle"
      }
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".categories-table"
        },
        {
          "type": "element_exists",
          "selector": ".category-tree"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/other/categories_list.png"
    }
  ]
}