{
  "id": "REG-034",
  "name": "Validation Rules",
  "type": "regression",
  "priority": "low",
  "engine": "agent-browser",
  "url": "http://localhost:5173/validation-rules",
  "timeout": 10000,
  "module": "other",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".validation-container"
      },
      "timeout": 30000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".rules-list"
        },
        {
          "type": "element_exists",
          "selector": ".rule-editor"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/other/validation_rules.png"
    }
  ]
}