{
  "id": "REG-033",
  "name": "API Documentation",
  "type": "regression",
  "priority": "low",
  "engine": "agent-browser",
  "url": "http://localhost:5173/api-docs",
  "timeout": 10000,
  "module": "other",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".api-docs-container"
      },
      "timeout": 30000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".api-docs"
        },
        {
          "type": "element_exists",
          "selector": ".endpoint-list"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/other/api_documentation.png"
    }
  ]
}