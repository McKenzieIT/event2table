{
  "id": "AN-003",
  "name": "Games Search Functionality",
  "type": "regression",
  "priority": "high",
  "engine": "agent-browser",
  "url": "http://localhost:5173/games",
  "timeout": 30000,
  "steps": [
    {
      "action": "open",
      "url": "http://localhost:5173/games"
    },
    {
      "action": "wait",
      "condition": {
        "selector": "input[placeholder*='搜索']"
      },
      "timeout": 45000
    },
    {
      "action": "wait",
      "condition": {
        "selector": ".virtual-table-body"
      },
      "timeout": 45000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "element_exists",
          "selector": ".table-row"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/games-search-results.png"
    }
  ]
}