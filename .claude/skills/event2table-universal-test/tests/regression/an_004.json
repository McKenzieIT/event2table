{
  "id": "AN-004",
  "name": "Events List with Game Context",
  "type": "regression",
  "priority": "critical",
  "engine": "agent-browser",
  "url": "http://localhost:5173/events?game_gid=10000147",
  "timeout": 30000,
  "steps": [
    {
      "action": "open",
      "url": "http://localhost:5173/events?game_gid=10000147"
    },
    {
      "action": "wait",
      "condition": {
        "selector": ".events-table"
      },
      "timeout": 15000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".events-table"
        },
        {
          "type": "element_exists",
          "selector": ".pagination"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/events-list-display.png"
    }
  ]
}