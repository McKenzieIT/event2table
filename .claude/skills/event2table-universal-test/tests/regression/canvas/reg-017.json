{
  "id": "REG-017",
  "name": "Event Node Builder",
  "type": "regression",
  "priority": "critical",
  "engine": "agent-browser",
  "url": "http://localhost:5173/event-node-builder",
  "timeout": 10000,
  "module": "canvas",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".event-node-builder"
      },
      "timeout": 30000
    },
    {
      "action": "snapshot",
      "saveRefs": true
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".event-node-builder"
        },
        {
          "type": "element_exists",
          "selector": "[data-testid=\"event-node-builder\"]"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/canvas/event_node_builder.png"
    }
  ]
}