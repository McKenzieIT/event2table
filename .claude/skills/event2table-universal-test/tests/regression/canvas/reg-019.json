{
  "id": "REG-019",
  "name": "Field Builder",
  "type": "regression",
  "priority": "high",
  "engine": "agent-browser",
  "url": "http://localhost:5173/field-builder",
  "timeout": 10000,
  "module": "canvas",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".field-builder-page"
      },
      "timeout": 30000
    },
    {
      "action": "snapshot",
      "saveRefs": true
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".field-builder-page"
        },
        {
          "type": "element_exists",
          "selector": "[data-testid=\"field-builder-page\"]"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/canvas/field_builder.png"
    }
  ]
}