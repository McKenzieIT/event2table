{
  "id": "REG-021",
  "name": "Flows List",
  "type": "regression",
  "priority": "high",
  "engine": "agent-browser",
  "url": "http://localhost:5173/flows",
  "timeout": 10000,
  "module": "canvas",
  "steps": [
    {
      "action": "open",
      "url": "http://localhost:5173/flows"
    },
    {
      "action": "wait",
      "condition": {
        "load": "networkidle"
      }
    },
    {
      "action": "snapshot",
      "saveRefs": true
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".flows-list"
        },
        {
          "type": "element_exists",
          "selector": ".flow-status"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/canvas/flows_list.png"
    }
  ]
}