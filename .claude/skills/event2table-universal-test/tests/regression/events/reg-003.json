{
  "id": "REG-003",
  "name": "Events List Display",
  "type": "regression",
  "priority": "critical",
  "engine": "agent-browser",
  "url": "http://localhost:5173/events",
  "timeout": 10000,
  "module": "events",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".events-table-container"
      },
      "timeout": 30000
    },
    {
      "action": "snapshot",
      "saveRefs": true
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".events-table"
        },
        {
          "type": "element_exists",
          "selector": ".pagination"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/events/events_list_display.png"
    }
  ]
}