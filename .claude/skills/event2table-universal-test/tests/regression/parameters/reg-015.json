{
  "id": "REG-015",
  "name": "Common Parameters",
  "type": "regression",
  "priority": "medium",
  "engine": "agent-browser",
  "url": "http://localhost:5173/common-params",
  "timeout": 10000,
  "module": "parameters",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".common-params-page"
      },
      "timeout": 60000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".common-params-table"
        },
        {
          "type": "element_exists",
          "selector": ".param-definitions"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/parameters/common_parameters.png"
    }
  ]
}