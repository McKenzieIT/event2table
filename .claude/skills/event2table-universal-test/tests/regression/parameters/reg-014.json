{
  "id": "REG-014",
  "name": "Parameter Network",
  "type": "regression",
  "priority": "low",
  "engine": "agent-browser",
  "url": "http://localhost:5173/parameter-network",
  "timeout": 10000,
  "module": "parameters",
  "steps": [
    {
      "action": "wait",
      "condition": {
        "selector": ".parameter-network-container"
      },
      "timeout": 60000
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".network-graph"
        },
        {
          "type": "element_exists",
          "selector": ".node-details"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/parameters/parameter_network.png"
    }
  ]
}