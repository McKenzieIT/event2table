{
  "id": "REG-010",
  "name": "Parameter Compare",
  "type": "regression",
  "priority": "medium",
  "engine": "agent-browser",
  "url": "http://localhost:5173/parameters/compare",
  "timeout": 10000,
  "module": "parameters",
  "steps": [
    {
      "action": "open",
      "url": "http://localhost:5173/parameters/compare"
    },
    {
      "action": "wait",
      "condition": {
        "load": "networkidle"
      }
    },
    {
      "action": "validate",
      "checks": [
        {
          "type": "console_clean",
          "level": "error"
        },
        {
          "type": "element_exists",
          "selector": ".comparison-table"
        },
        {
          "type": "element_exists",
          "selector": ".diff-view"
        }
      ]
    },
    {
      "action": "screenshot",
      "path": "output/screenshots/regression/parameters/parameter_compare.png"
    }
  ]
}